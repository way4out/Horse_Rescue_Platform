<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#10251b">
<meta name="description" content="Horse Rescue — rescue, rehabilitation, adoption, sponsorship and lifelong sanctuary. Every horse deserves a future.">
<meta name="robots" content="index,follow">
<title>Horse Rescue | Every Horse Deserves a Future</title>

<style>
:root{
  --ink:#10251b;
  --ink2:#193326;
  --paper:#f7f4ed;
  --paper2:#eee8da;
  --card:#fffdf8;
  --line:#d8d0c0;
  --text:#18221c;
  --muted:#657067;
  --rust:#b6673d;
  --gold:#bd9551;
  --sage:#657a63;
  --danger:#9b3d32;
  --shadow:0 18px 55px rgba(16,37,27,.10);
  --radius:22px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  color:var(--text);
  background:var(--paper);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  line-height:1.55;
}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
img{max-width:100%}
.hidden{display:none!important}

.container{
  width:min(1180px,calc(100% - 36px));
  margin:auto;
}

/* NAV */
.nav{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(247,244,237,.94);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  min-height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
}
.logo{
  font-size:1.05rem;
  font-weight:950;
  letter-spacing:-.045em;
  white-space:nowrap;
}
.logo span{color:var(--rust)}
.desktop-nav{
  display:flex;
  align-items:center;
  gap:20px;
  font-size:.88rem;
  font-weight:800;
}
.desktop-nav a:hover{color:var(--rust)}
.nav-actions{display:flex;gap:8px;align-items:center}

/* BUTTONS */
.btn{
  border:1px solid var(--line);
  border-radius:999px;
  padding:11px 17px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  font-weight:900;
  transition:.2s ease;
}
.btn:hover{transform:translateY(-1px)}
.btn-dark{
  background:var(--ink);
  color:white;
  border-color:var(--ink);
}
.btn-light{
  background:white;
  color:var(--ink);
}
.btn-rust{
  background:var(--rust);
  color:white;
  border-color:var(--rust);
}
.btn-danger{
  background:var(--danger);
  color:white;
  border-color:var(--danger);
}
.btn-small{
  padding:8px 12px;
  font-size:.82rem;
}

/* HERO */
.hero{
  color:white;
  background:
    radial-gradient(circle at 85% 25%,rgba(189,149,81,.23),transparent 30%),
    linear-gradient(135deg,#0d2118,#1b3829 65%,#274634);
  padding:76px 0 60px;
  overflow:hidden;
}
.hero-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr;
  gap:50px;
  align-items:end;
}
.eyebrow{
  color:#e1cda9;
  text-transform:uppercase;
  letter-spacing:.17em;
  font-size:.72rem;
  font-weight:950;
}
.hero h1{
  font-size:clamp(3.3rem,8vw,7.6rem);
  line-height:.87;
  letter-spacing:-.08em;
  margin:18px 0 26px;
  max-width:850px;
}
.hero-copy{
  max-width:680px;
  color:#d8e1da;
  font-size:1.12rem;
}
.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:28px;
}
.hero .btn-light{
  background:white;
  color:var(--ink);
  border-color:white;
}
.hero .btn-outline{
  color:white;
  border-color:rgba(255,255,255,.35);
}
.hero .btn-outline:hover{background:rgba(255,255,255,.08)}

.hero-panel{
  border:1px solid rgba(255,255,255,.17);
  background:rgba(255,255,255,.07);
  border-radius:28px;
  padding:26px;
  backdrop-filter:blur(8px);
}
.hero-panel h3{
  margin:0 0 16px;
  font-size:1.3rem;
}
.emergency-line{
  padding:14px;
  border-radius:15px;
  background:rgba(182,103,61,.22);
  border:1px solid rgba(255,255,255,.13);
  margin-bottom:16px;
}
.emergency-line strong{display:block;font-size:1.5rem}
.emergency-line span{font-size:.84rem;color:#d9e0db}
.stats{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}
.stat{
  padding:15px;
  border-radius:15px;
  background:rgba(255,255,255,.07);
}
.stat strong{display:block;font-size:1.65rem}
.stat small{color:#b9c8be}

/* SECTIONS */
.section{
  padding:76px 0;
}
.section.alt{background:var(--paper2)}
.section.dark{background:var(--ink);color:white}
.section.rust{background:var(--rust);color:white}
.section-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:35px;
  margin-bottom:30px;
}
.kicker{
  color:var(--rust);
  text-transform:uppercase;
  letter-spacing:.15em;
  font-weight:950;
  font-size:.7rem;
}
.dark .kicker,.rust .kicker{color:#e4c89b}
.section h2{
  font-size:clamp(2.2rem,5vw,4.7rem);
  line-height:.94;
  letter-spacing:-.065em;
  margin:8px 0 0;
}
.section-head p{
  max-width:520px;
  color:var(--muted);
}
.dark .section-head p,.rust .section-head p{color:#d3ddd5}

/* CARDS */
.cards-3{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}
.card{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
}
.card-body{padding:23px}
.card h3{
  margin:8px 0 8px;
  font-size:1.5rem;
  letter-spacing:-.04em;
}
.card p{color:var(--muted)}
.tier-card{
  min-height:270px;
  padding:28px;
  position:relative;
  overflow:hidden;
}
.tier-card:after{
  content:"";
  position:absolute;
  width:150px;
  height:150px;
  right:-65px;
  bottom:-65px;
  border-radius:50%;
  background:var(--paper2);
}
.tier-num{
  color:var(--rust);
  font-weight:950;
}
.tier-card h3{margin-top:38px}

/* HORSES */
.toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  margin-bottom:20px;
  flex-wrap:wrap;
}
.filters{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}
.filter{
  border:1px solid var(--line);
  border-radius:999px;
  padding:9px 13px;
  background:transparent;
  font-weight:850;
}
.filter.active,.filter:hover{
  background:var(--ink);
  color:white;
  border-color:var(--ink);
}
.search{
  border:1px solid var(--line);
  background:white;
  border-radius:999px;
  padding:11px 15px;
  min-width:220px;
  outline:none;
}
.search:focus{border-color:var(--rust)}

.horse-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}
.horse-card{
  background:white;
  border:1px solid var(--line);
  border-radius:20px;
  overflow:hidden;
  box-shadow:0 4px 18px rgba(16,37,27,.04);
}
.horse-photo{
  width:100%;
  height:235px;
  object-fit:cover;
  display:block;
  background:#ddd;
}
.horse-body{padding:18px}
.badge{
  display:inline-flex;
  align-items:center;
  gap:5px;
  padding:5px 9px;
  border-radius:999px;
  background:var(--paper2);
  font-size:.68rem;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.07em;
}
.badge.adoptable{background:#e4eee0;color:#355333}
.badge.evaluation{background:#f2e9d7;color:#745b25}
.badge.sanctuary{background:#e7e4ee;color:#55466f}
.demo-label{
  margin-top:10px;
  color:var(--rust);
  font-size:.68rem;
  font-weight:950;
  letter-spacing:.07em;
}

/* JOURNEY */
.journey{
  display:grid;
  grid-template-columns:.65fr 1.35fr;
  gap:55px;
}
.steps{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}
.step{
  padding:22px;
  background:white;
  border:1px solid var(--line);
  border-radius:18px;
}
.step-num{
  color:var(--rust);
  font-size:.7rem;
  font-weight:950;
  letter-spacing:.12em;
}
.step strong{display:block;margin:7px 0}
.step span{color:var(--muted);font-size:.9rem}

/* HELP */
.help-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:13px;
}
.help-card{
  padding:24px;
  background:white;
  border:1px solid var(--line);
  border-radius:20px;
}
.help-card .icon{
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  border-radius:14px;
  background:var(--paper2);
  margin-bottom:16px;
  font-size:1.25rem;
}
.help-card h3{margin:0 0 7px}
.help-card p{color:var(--muted);font-size:.9rem}
.arrow{color:var(--rust);font-weight:950}

/* FORM */
.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}
.form-field{display:grid;gap:6px}
.form-field.full{grid-column:1/-1}
.form-field label{
  font-size:.78rem;
  font-weight:900;
}
input,select,textarea{
  width:100%;
  border:1px solid var(--line);
  background:white;
  border-radius:13px;
  padding:13px 14px;
  color:var(--text);
  outline:none;
}
input:focus,select:focus,textarea:focus{
  border-color:var(--rust);
  box-shadow:0 0 0 3px rgba(182,103,61,.10);
}
textarea{min-height:130px;resize:vertical}

/* ADMIN */
.admin{
  background:#0b1812;
  color:#eaf0eb;
}
.admin .section-head p{color:#aebdb2}
.admin-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
}
.admin-stat{
  padding:20px;
  border-radius:18px;
  background:#14291f;
  border:1px solid #294235;
}
.admin-stat strong{display:block;font-size:2rem}
.admin-stat span{color:#9db0a3;font-size:.82rem}
.admin-panels{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
  margin-top:15px;
}
.admin-panel{
  padding:22px;
  background:#14291f;
  border:1px solid #294235;
  border-radius:20px;
}
.admin-panel h3{margin-top:0}
.admin input,.admin select,.admin textarea{
  background:#0d1d15;
  border-color:#345040;
  color:#eaf0eb;
}
.admin table{
  width:100%;
  border-collapse:collapse;
}
.admin th,.admin td{
  padding:10px;
  border-bottom:1px solid #294235;
  text-align:left;
  font-size:.83rem;
}
.admin th{color:#aebdb2}

/* MODAL */
.modal{
  position:fixed;
  inset:0;
  z-index:500;
  background:rgba(4,12,8,.72);
  backdrop-filter:blur(8px);
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
}
.modal.open{display:flex}
.modal-box{
  width:min(760px,100%);
  max-height:90vh;
  overflow:auto;
  background:var(--paper);
  color:var(--text);
  border-radius:25px;
  padding:28px;
  box-shadow:0 30px 100px rgba(0,0,0,.3);
}
.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:start;
  gap:15px;
}
.close{
  border:0;
  background:var(--paper2);
  width:40px;
  height:40px;
  border-radius:50%;
  font-size:1.2rem;
}

/* TOAST */
.toast{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:900;
  background:var(--ink);
  color:white;
  padding:14px 18px;
  border-radius:14px;
  box-shadow:var(--shadow);
  transform:translateY(140%);
  transition:.3s ease;
  max-width:380px;
}
.toast.show{transform:translateY(0)}

/* FOOTER */
footer{
  background:#09150f;
  color:#aebbb1;
  padding:45px 0 90px;
}
.footer-grid{
  display:grid;
  grid-template-columns:1.2fr .8fr .8fr;
  gap:30px;
}
.footer-brand{
  color:white;
  font-size:1.2rem;
  font-weight:950;
}
.footer h4{color:white;margin-top:0}
.footer-links{display:grid;gap:7px;font-size:.88rem}
.footer-links a:hover{color:white}

/* MOBILE */
.mobile-bar{
  display:none;
}
@media(max-width:950px){
  .desktop-nav{display:none}
  .hero-grid,.journey{grid-template-columns:1fr}
  .cards-3,.horse-grid{grid-template-columns:repeat(2,1fr)}
  .help-grid{grid-template-columns:repeat(2,1fr)}
  .admin-grid{grid-template-columns:repeat(2,1fr)}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:650px){
  .container{width:min(100% - 28px,1180px)}
  .hero{padding:55px 0 42px}
  .hero h1{font-size:clamp(3rem,18vw,5rem)}
  .section{padding:56px 0}
  .section-head{display:block}
  .cards-3,.horse-grid,.help-grid,.admin-grid,.admin-panels,.footer-grid{grid-template-columns:1fr}
  .steps,.form-grid{grid-template-columns:1fr}
  .form-field.full{grid-column:auto}
  .search{width:100%;min-width:0}
  .nav-actions .btn-light{display:none}
  .mobile-bar{
    display:flex;
    position:fixed;
    left:10px;
    right:10px;
    bottom:10px;
    z-index:300;
    background:var(--ink);
    color:white;
    border-radius:18px;
    padding:8px;
    justify-content:space-around;
    box-shadow:0 12px 45px rgba(0,0,0,.28);
  }
  .mobile-bar a{
    font-size:.7rem;
    font-weight:850;
    padding:7px;
  }
}

/* PRINT */
@media print{
  .nav,.mobile-bar,.hero-actions,.toolbar,.btn,.toast,footer{display:none!important}
  .section{padding:20px 0}
}
</style>
</head>

<body>

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href="#top">HORSE<span>RESCUE</span></a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href="#horses">Horses</a>
      <a href="#model">Our Model</a>
      <a href="#journey">Journey</a>
      <a href="#help">Help</a>
      <a href="#contact">Contact</a>
      <a href="#admin">Operations</a>
    </nav>

    <div class="nav-actions">
      <a class="btn btn-light btn-small" href="#horses">Meet Horses</a>
      <a class="btn btn-dark btn-small" href="#help">Help Save One</a>
    </div>
  </div>
</header>

<main id="top">

<!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow">Williams, Arizona · Emergency Equine Rescue</div>

      <h1>Every horse deserves a future.</h1>

      <p class="hero-copy">
        A horse-first rescue platform built to move horses from crisis to safety,
        rehabilitation, adoption, or lifelong sanctuary — with honest records,
        transparent outcomes, and a community built around care.
      </p>

      <div class="hero-actions">
        <a class="btn btn-light" href="#horses">Meet the Horses →</a>
        <a class="btn btn-outline" href="#help">Get Involved</a>
        <a class="btn btn-outline" href="#contact">Contact Rescue</a>
      </div>
    </div>

    <aside class="hero-panel">
      <div class="eyebrow">Current emergency mission</div>

      <div class="emergency-line">
        <strong>45 horses</strong>
        <span>Current emergency rescue target</span>
      </div>

      <div class="stats">
        <div class="stat">
          <strong>3</strong>
          <small>Welfare outcome pathways</small>
        </div>
        <div class="stat">
          <strong>24/7</strong>
          <small>Commitment to each horse</small>
        </div>
        <div class="stat">
          <strong>1</strong>
          <small>Horse-first mission</small>
        </div>
        <div class="stat">
          <strong>∞</strong>
          <small>Long-term possibilities</small>
        </div>
      </div>
    </aside>
  </div>
</section>

<!-- MISSION -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <div>
        <div class="kicker">The mission</div>
        <h2>Rescue first. Understand completely. Place responsibly.</h2>
      </div>
      <p>
        Every horse gets an individual assessment. Outcome status is based on
        welfare, veterinary, behavioral, training, and practical considerations —
        never on a horse's perceived value.
      </p>
    </div>

    <div class="cards-3" id="model">

      <article class="card tier-card">
        <div class="tier-num">01 · ADOPTABLE</div>
        <h3>Ready for the next chapter.</h3>
        <p>
          Horses assessed as appropriate for adoption can receive a detailed
          public profile and a responsible home-matching process.
        </p>
      </article>

      <article class="card tier-card">
        <div class="tier-num">02 · EVALUATION</div>
        <h3>Still healing. Still learning.</h3>
        <p>
          Horses continue veterinary care, rehabilitation, training and
          behavioral evaluation while the best long-term outcome is determined.
        </p>
      </article>

      <article class="card tier-card">
        <div class="tier-num">03 · SANCTUARY</div>
        <h3>Here for life.</h3>
        <p>
          Permanent pasture or sanctuary care is available when lifelong care
          is the most appropriate welfare outcome. Sanctuary is not a lesser
          status.
        </p>
      </article>

    </div>
  </div>
</section>

<!-- HORSES -->
<section class="section alt" id="horses">
  <div class="container">

    <div class="section-head">
      <div>
        <div class="kicker">Horse directory</div>
        <h2>Follow every journey.</h2>
      </div>
      <p>
        These example profiles demonstrate the platform. Replace them with
        verified horse records before presenting them as real rescue cases.
      </p>
    </div>

    <div class="toolbar">
      <div class="filters" role="group" aria-label="Horse filters">
        <button class="filter active" data-filter="all">All</button>
        <button class="filter" data-filter="adoptable">Adoptable</button>
        <button class="filter" data-filter="evaluation">Evaluation</button>
        <button class="filter" data-filter="sanctuary">Sanctuary</button>
      </div>

      <input id="horseSearch" class="search" placeholder="Search horses..." aria-label="Search horses">
    </div>

    <div class="horse-grid" id="horseGrid"></div>

  </div>
</section>

<!-- JOURNEY -->
<section class="section" id="journey">
  <div class="container journey">

    <div>
      <div class="kicker">Rescue journey</div>
      <h2>From crisis to clarity.</h2>

      <p style="color:var(--muted);margin-top:20px">
        A consistent journey gives staff, supporters and future adopters a
        clear picture of what happens after rescue.
      </p>

      <a class="btn btn-dark" href="#contact">Support the Mission →</a>
    </div>

    <div class="steps">

      <div class="step">
        <div class="step-num">01</div>
        <strong>Rescued</strong>
        <span>Document origin, urgency, identification and transport status.</span>
      </div>

      <div class="step">
        <div class="step-num">02</div>
        <strong>Safe Intake</strong>
        <span>Photographs, identification, baseline observations and records.</span>
      </div>

      <div class="step">
        <div class="step-num">03</div>
        <strong>Quarantine</strong>
        <span>Biosecurity separation and initial health monitoring.</span>
      </div>

      <div class="step">
        <div class="step-num">04</div>
        <strong>Assessment</strong>
        <span>Veterinary, dental, behavioral and handling evaluation.</span>
      </div>

      <div class="step">
        <div class="step-num">05</div>
        <strong>Rehabilitation</strong>
        <span>Nutrition, treatment, training, recovery and confidence building.</span>
      </div>

      <div class="step">
        <div class="step-num">06</div>
        <strong>Outcome</strong>
        <span>Adoption, continued evaluation, or permanent sanctuary.</span>
      </div>

    </div>
  </div>
</section>

<!-- TRANSPARENCY -->
<section class="section rust">
  <div class="container">
    <div class="kicker">Transparency by design</div>

    <h2 style="max-width:850px">
      Make every horse's story visible without compromising safety or privacy.
    </h2>

    <p style="max-width:760px;font-size:1.05rem">
      The platform is structured so supporters can eventually follow rescue,
      rehabilitation, milestones, adoption and sanctuary stories while
      sensitive medical, financial and personal information remains protected.
    </p>

    <div style="margin-top:25px">
      <a class="btn btn-light" href="#contact">Build the Network →</a>
    </div>
  </div>
</section>

<!-- HELP -->
<section class="section" id="help">
  <div class="container">

    <div class="section-head">
      <div>
        <div class="kicker">Get involved</div>
        <h2>There is more than one way to help.</h2>
      </div>

      <p>
        Rescue requires an entire network: adopters, sponsors, volunteers,
        veterinarians, dentists, transporters, feed suppliers, fencing
        providers and supporters.
      </p>
    </div>

    <div class="help-grid">

      <a class="help-card" href="#contact" data-interest="Adoption">
        <div class="icon">🏠</div>
        <h3>Adopt</h3>
        <p>Help give an appropriate horse a safe and responsible next home.</p>
        <div class="arrow">Adoption interest →</div>
      </a>

      <a class="help-card" href="#contact" data-interest="Sponsorship">
        <div class="icon">❤️</div>
