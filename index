<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
/* ==========================================================
   HORSE RESCUE WEB PLATFORM
   Static GitHub Pages edition
   ========================================================== */

const STORAGE_KEY = "horseRescuePlatform_v1";

const defaultData = {
  horses: [
    {
      id:"demo-a",
      name:"Demo Horse A",
      tier:"adoptable",
      breed:"Example profile",
      age:"Unknown",
      notes:"DEMO DATA — replace with a verified rescue record.",
      photo:"https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?auto=format&fit=crop&w=1200&q=82",
      demo:true
    },
    {
      id:"demo-b",
      name:"Demo Horse B",
      tier:"evaluation",
      breed:"Example profile",
      age:"Unknown",
      notes:"DEMO DATA — replace with a verified rescue record.",
      photo:"https://images.unsplash.com/photo-1551884831-bbf3cdc6469e?auto=format&fit=crop&w=1200&q=82",
      demo:true
    },
    {
      id:"demo-c",
      name:"Demo Horse C",
      tier:"sanctuary",
      breed:"Example profile",
      age:"Unknown",
      notes:"DEMO DATA — replace with a verified rescue record.",
      photo:"https://images.unsplash.com/photo-1534773728080-33d31da27ae5?auto=format&fit=crop&w=1200&q=82",
      demo:true
    }
  ],
  interests:[],
  care:[],
  tasks:[]
};

function loadData(){
  try{
    const saved = localStorage.getItem(STORAGE_KEY);

    if(!saved){
      localStorage.setItem(STORAGE_KEY,JSON.stringify(defaultData));
      return structuredClone(defaultData);
    }

    const parsed = JSON.parse(saved);

    return {
      horses:Array.isArray(parsed.horses)?parsed.horses:[],
      interests:Array.isArray(parsed.interests)?parsed.interests:[],
      care:Array.isArray(parsed.care)?parsed.care:[],
      tasks:Array.isArray(parsed.tasks)?parsed.tasks:[]
    };
  }catch(error){
    console.error(error);
    return structuredClone(defaultData);
  }
}

let data = loadData();

function saveData(){
  localStorage.setItem(STORAGE_KEY,JSON.stringify(data));
}

function uid(prefix="id"){
  return prefix+"_"+Date.now()+"_"+Math.random().toString(36).slice(2,8);
}

function esc(value){
  return String(value ?? "")
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}

function toast(message){
  const el=document.getElementById("toast");
  el.textContent=message;
  el.classList.add("show");

  clearTimeout(window.__toastTimer);

  window.__toastTimer=setTimeout(()=>{
    el.classList.remove("show");
  },3500);
}

function tierLabel(tier){
  return {
    adoptable:"Adoptable",
    evaluation:"Evaluation",
    sanctuary:"Sanctuary"
  }[tier] || "Evaluation";
}

function renderHorses(){
  const grid=document.getElementById("horseGrid");

  const activeFilter=
    document.querySelector(".filter.active")?.dataset.filter || "all";

  const query=
    document.getElementById("horseSearch")?.value
      .trim()
      .toLowerCase() || "";

  const filtered=data.horses.filter(h=>{
    const matchesTier=
      activeFilter==="all" || h.tier===activeFilter;

    const haystack=[
      h.name,
      h.breed,
      h.age,
      h.notes,
      h.tier
    ].join(" ").toLowerCase();

    return matchesTier && haystack.includes(query);
  });

  if(!filtered.length){
    grid.innerHTML=`
      <div class="card" style="padding:30px;grid-column:1/-1">
        <h3>No horses match this search.</h3>
        <p>Try another filter or search term.</p>
      </div>`;
    return;
  }

  grid.innerHTML=filtered.map(h=>`
    <article class="horse-card">

      <img
        class="horse-photo"
        src="${esc(h.photo || "https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?auto=format&fit=crop&w=1200&q=82")}"
        alt="${esc(h.name)}"
        loading="lazy"
      >

      <div class="horse-body">

        <span class="badge ${esc(h.tier)}">
          ${esc(tierLabel(h.tier))}
        </span>

        <h3>${esc(h.name)}</h3>

        <p>
          ${esc(h.breed || "Individual horse profile")}
          ${h.age ? " · "+esc(h.age) : ""}
        </p>

        <p>
          ${esc(h.notes || "Profile information will appear here.")}
        </p>

        ${h.demo ? `<div class="demo-label">DEMO DATA — NOT A REAL HORSE</div>` : ""}

        <button
          class="btn btn-dark btn-small"
          style="margin-top:12px"
          onclick="openHorse('${esc(h.id)}')"
        >
          View Profile
        </button>

      </div>
    </article>
  `).join("");
}

function openHorse(id){
  const horse=data.horses.find(h=>h.id===id);

  if(!horse)return;

  document.getElementById("modalHorseName").textContent=horse.name;

  document.getElementById("modalHorseBody").innerHTML=`
    <img
      src="${esc(horse.photo)}"
      alt="${esc(horse.name)}"
      style="width:100%;max-height:370px;object-fit:cover;border-radius:18px"
    >

    <div style="margin-top:20px">
      <span class="badge ${esc(horse.tier)}">
        ${esc(tierLabel(horse.tier))}
      </span>

      <div class="cards-3" style="margin-top:16px">

        <div class="card" style="padding:16px">
          <strong>Breed</strong>
          <div>${esc(horse.breed || "Not recorded")}</div>
        </div>

        <div class="card" style="padding:16px">
          <strong>Age</strong>
          <div>${esc(horse.age || "Not recorded")}</div>
        </div>

        <div class="card" style="padding:16px">
          <strong>Status</strong>
          <div>${esc(tierLabel(horse.tier))}</div>
        </div>

      </div>

      <h3>Story / Notes</h3>

      <p>${esc(horse.notes || "No public notes recorded.")}</p>

      ${horse.demo ? `
        <div style="
          padding:14px;
          border-radius:13px;
          background:#f2e9d7;
          color:#654d22;
          font-weight:800;
        ">
          This is demonstration data. Replace it with verified information
          before presenting the horse publicly.
        </div>
      ` : ""}

      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:18px">
        <button
          class="btn btn-dark"
          onclick="selectInterest('Adoption','${esc(horse.name)}')"
        >
          Adoption Interest
        </button>

        <button
          class="btn"
          onclick="selectInterest('Sponsorship','${esc(horse.name)}')"
        >
          Sponsor This Horse
        </button>
      </div>

    </div>
  `;

  document.getElementById("horseModal").classList.add("open");
}

function selectInterest(type,horseName=""){
  document.getElementById("interest").value=type;

  if(horseName){
    document.getElementById("message").value=
      `I am interested in ${type.toLowerCase()} for ${horseName}.`;
  }

  document.getElementById("horseModal").classList.remove("open");

  document.getElementById("contact").scrollIntoView({
    behavior:"smooth"
  });
}

window.openHorse=openHorse;
window.selectInterest=selectInterest;

/* FILTERS */

document.querySelectorAll(".filter").forEach(button=>{
  button.addEventListener("click",()=>{
    document.querySelectorAll(".filter")
      .forEach(b=>b.classList.remove("active"));

    button.classList.add("active");

    renderHorses();
  });
});

document.getElementById("horseSearch")
  .addEventListener("input",renderHorses);

/* MODAL */

document.querySelectorAll("[data-close]").forEach(button=>{
  button.addEventListener("click",()=>{
    document.getElementById(button.dataset.close)
      .classList.remove("open");
  });
});

document.getElementById("horseModal")
  .addEventListener("click",event=>{
    if(event.target.id==="horseModal"){
      event.currentTarget.classList.remove("open");
    }
  });

/* HELP CARD PRESELECT */

document.querySelectorAll("[data-interest]").forEach(card=>{
  card.addEventListener("click",()=>{
    setTimeout(()=>{
      document.getElementById("interest").value=
        card.dataset.interest;
    },100);
  });
});

/* INTEREST FORM */

document.getElementById("interestForm")
  .addEventListener("submit",event=>{
    event.preventDefault();

    const record={
      id:uid("interest"),
      date:new Date().toISOString(),
      name:document.getElementById("name").value.trim(),
      email:document.getElementById("email").value.trim(),
      phone:document.getElementById("phone").value.trim(),
      interest:document.getElementById("interest").value,
      message:document.getElementById("message").value.trim()
    };

    data.interests.unshift(record);

    saveData();
    updateAdmin();

    event.target.reset();

    toast(
      "Saved in this browser. Connect a secure backend before using this for live public submissions."
    );
  });

/* HORSE FORM */

document.getElementById("horseForm")
  .addEventListener("submit",event=>{
    event.preventDefault();

    const horse={
      id:uid("horse"),
      name:document.getElementById("horseName").value.trim(),
      tier:document.getElementById("horseTier").value,
      breed:document.getElementById("horseBreed").value.trim(),
      age:document.getElementById("horseAge").value.trim(),
      notes:document.getElementById("horseNotes").value.trim(),
      photo:"https://images.unsplash.com/photo-1553284965-83fd3e82fa5a?auto=format&fit=crop&w=1200&q=82",
      demo:false
    };

    data.horses.unshift(horse);

    saveData();
    renderHorses();
    updateAdmin();
    updateCareHorseOptions();

    event.target.reset();

    toast("Horse record added to this browser.");
  });

/* CARE FORM */

document.getElementById("careForm")
  .addEventListener("submit",event=>{
    event.preventDefault();

    const horseId=document.getElementById("careHorse").value;

    if(!horseId){
      toast("Add a horse record first.");
      return;
    }

    const horse=data.horses.find(h=>h.id===horseId);

    const record={
      id:uid("care"),
      date:new Date().toISOString(),
      horseId,
      horseName:horse?.name || "Unknown",
      type:document.getElementById("careType").value,
      notes:document.getElementById("careNotes").value.trim()
    };

    data.care.unshift(record);

    saveData();
    updateAdmin();

    document.getElementById("careNotes").value="";

    toast("Care record saved locally.");
  });

/* TASK FORM */

document.getElementById("taskForm")
  .addEventListener("submit",event=>{
    event.preventDefault();

    const task={
      id:uid("task"),
      date:new Date().toISOString(),
      text:document.getElementById("taskText").value.trim(),
      complete:false
    };

    data.tasks.unshift(task);

    saveData();
    updateAdmin();

    event.target.reset();

    toast("Task added.");
  });

function updateCareHorseOptions(){
  const select=document.getElementById("careHorse");

  select.innerHTML=data.horses.map(h=>`
    <option value="${esc(h.id)}">${esc(h.name)}</option>
  `).join("");
}

function updateAdmin(){

  document.getElementById("adminHorseCount").textContent=
    data.horses.length;

  document.getElementById("adminInterestCount").textContent=
    data.interests.length;

  document.getElementById("adminCareCount").textContent=
    data.care.length;

  document.getElementById("adminTaskCount").textContent=
    data.tasks.filter(t=>!t.complete).length;

  document.getElementById("taskList").innerHTML=
    data.tasks.length
      ? data.tasks.map(task=>`
        <div style="
          display:flex;
          justify-content:space-between;
          gap:10px;
          align-items:center;
          padding:10px 0;
          border-bottom:1px solid #294235;
        ">
          <label style="
            display:flex;
            gap:8px;
            align-items:center;
            ${task.complete?"text-decoration:line-through;opacity:.55":""}
          ">
            <input
              type="checkbox"
              ${task.complete?"checked":""}
              onchange="toggleTask('${task.id}')"
            >
            ${esc(task.text)}
          </label>

          <button
            class="btn btn-danger btn-small"
            onclick="deleteTask('${task.id}')"
          >
            ×
          </button>
        </div>
      `).join("")
      :
      `<p style="color:#9db0a3">No tasks yet.</p>`;

  document.getElementById("careTable").innerHTML=
    data.care.length
      ? data.care.slice(0,20).map(record=>`
        <tr>
          <td>${new Date(record.date).toLocaleDateString()}</td>
          <td>${esc(record.horseName)}</td>
          <td>${esc(record.type)}</td>
          <td>${esc(record.notes)}</td>
        </tr>
      `).join("")
      :
      `<tr><td colspan="4">No care records yet.</td></tr>`;
}

function toggleTask(id){
  const task=data.tasks.find(t=>t.id===id);

  if(task){
    task.complete=!task.complete;
    saveData();
    updateAdmin();
  }
}

function deleteTask(id){
  data.tasks=data.tasks.filter(t=>t.id!==id);
  saveData();
  updateAdmin();
}

window.toggleTask=toggleTask;
window.deleteTask=deleteTask;

/* EXPORT */

document.getElementById("exportData")
  .addEventListener("click",()=>{

    const blob=new Blob(
      [JSON.stringify(data,null,2)],
      {type:"application/json"}
    );

    const url=URL.createObjectURL(blob);

    const a=document.createElement("a");
    a.href=url;
    a.download=
      "horse-rescue-data-"+new Date().toISOString().slice(0,10)+".json";

    document.body.appendChild(a);
    a.click();
    a.remove();

    URL.revokeObjectURL(url);

    toast("Data export created.");
  });

/* IMPORT */

document.getElementById("importFile")
  .addEventListener("change",event=>{

    const file=event.target.files[0];

    if(!file)return;

    const reader=new FileReader();

    reader.onload=()=>{
      try{
        const imported=JSON.parse(reader.result);

        if(
          !Array.isArray(imported.horses) ||
          !Array.isArray(imported.interests) ||
          !Array.isArray(imported.care) ||
          !Array.isArray(imported.tasks)
        ){
          throw new Error("Invalid data format");
        }

        data=imported;

        saveData();
        renderHorses();
        updateAdmin();
        updateCareHorseOptions();

        toast("Data imported successfully.");
      }catch(error){
        toast("Import failed: invalid rescue data file.");
      }
    };

    reader.readAsText(file);
  });

/* CLEAR */

document.getElementById("clearData")
  .addEventListener("click",()=>{

    const confirmed=confirm(
      "Clear all locally stored rescue data from this browser?"
    );

    if(!confirmed)return;

    localStorage.removeItem(STORAGE_KEY);

    data=structuredClone(defaultData);

    saveData();
    renderHorses();
    updateAdmin();
    updateCareHorseOptions();

    toast("Local data reset.");
  });

/* INITIALIZE */

renderHorses();
updateAdmin();
updateCareHorseOptions();

/* Keyboard accessibility */

document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){
    document.querySelectorAll(".modal.open")
      .forEach(modal=>modal.classList.remove("open"));
  }
});

/* Smooth internal navigation */

document.querySelectorAll('a[href^="#"]').forEach(link=>{
  link.addEventListener("click",()=>{
    const target=document.querySelector(link.getAttribute("href"));

    if(target){
      setTimeout(()=>{
        target.setAttribute("tabindex","-1");
      },500);
    }
  });
});
</script>

</body>
</html>
